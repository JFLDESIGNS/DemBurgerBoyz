extends SceneTree
func _initialize() -> void: call_deferred("run")
func run() -> void:
	create_timer(15).timeout.connect(func(): quit(1))
	var actor = load("res://scenes/park_bird.tscn").instantiate()
	root.add_child(actor)
	actor.set_process(false)
	assert(actor.animator.get_animation_list().size() >= 5)
	assert(actor.state == &"Away" and actor.away_duration >= 27.0)
	var heard := {}
	actor.sound_triggered.connect(func(kind): heard[kind] = int(heard.get(kind, 0)) + 1)
	var seen := {}
	for n in 7200:
		actor.advance(1.0/60.0)
		actor.animator.advance(1.0/60.0)
		seen[actor.state] = true
		assert(actor.bird.position.is_finite())
	for clip in actor.CLIPS + [&"Away", &"Fly_In"]: assert(seen.has(clip), "Unvisited state: %s" % clip)
	for kind in [&"chirp", &"peck", &"wings"]: assert(heard.has(kind), "Missing audio event: %s" % kind)
	actor._enter(&"Mad_Peck")
	var before_pecks = heard.get(&"peck", 0)
	for n in 120: actor.advance(1.0 / 60.0)
	assert(heard[&"peck"] - before_pecks == 3)
	actor._enter(&"Takeoff"); actor.advance(0.22)
	assert(actor.state == &"Fly" and actor.wing_sound.playing)
	actor.advance(0.9)
	assert(actor.state == &"Away" and not actor.bird.visible and not actor.wing_sound.playing)
	assert(actor.bird.position.distance_to(actor.PERCH) > 9.0)
	actor.advance(actor.away_duration)
	assert(actor.state == &"Fly_In" and actor.bird.visible and actor.wing_sound.playing)
	actor.advance(1.1); actor.advance(0.4)
	assert(actor.bird.position.distance_to(actor.PERCH) < 0.001)
	actor._enter(&"Perch");actor.advance(0.4)
	assert(actor.bird.position.distance_to(actor.PERCH)<0.001)
	actor._enter(&"Idle");actor.react_to_tree_shake();assert(actor.state==&"Mad_Peck")
	actor.set_enabled(false);assert(not actor.voice.playing and not actor.wing_sound.playing and not actor.tap_sound.playing);var t=actor.state_time;actor.advance(5);assert(actor.state_time==t and not actor.visible)
	actor.set_enabled(true);assert(actor.state==&"Away" and actor.visible and not actor.bird.visible)
	actor._enter(&"Idle")
	var camera := Camera3D.new()
	root.add_child(camera)
	camera.position = Vector3(1.15, .75, 1.9)
	camera.look_at(Vector3(0, .36, .22))
	camera.make_current()
	var bird_mesh = actor.bird.find_children("*", "MeshInstance3D", true, false)[0]
	var bird_point = camera.unproject_position(bird_mesh.global_transform * bird_mesh.get_aabb().get_center())
	var chirps_before = heard.get(&"chirp", 0)
	assert(actor.tap_at(camera, bird_point))
	assert(heard[&"chirp"] == chirps_before + 1)
	actor._enter(&"Away")
	assert(actor.tap_at(camera, camera.unproject_position(actor.sway.to_global(Vector3(0, .4, 0)))))
	assert(actor.dragging_house and actor.swing_velocity.length() > 0.1)
	var press := InputEventMouseButton.new()
	press.button_index = MOUSE_BUTTON_LEFT
	press.pressed = true
	Input.parse_input_event(press)
	Input.flush_buffered_events()
	actor.drag_origin = root.get_mouse_position() - Vector2(80, 0)
	for n in 60: actor.advance(1.0 / 60.0)
	assert(actor.dragging_house and actor.swing.y < -.05, "Holding and pulling must tilt the house")
	press = press.duplicate()
	press.pressed = false
	Input.parse_input_event(press)
	Input.flush_buffered_events()
	actor.advance(.1)
	assert(not actor.dragging_house, "Release must free the pendulum")
	assert(actor.swing.length() > .001)
	for n in 1200: actor.advance(1.0 / 60.0)
	assert(actor.swing.length() < .001, "Swing must settle")
	actor.swing_velocity = Vector2.ZERO
	actor._enter(&"Perch"); actor.advance(.4)
	assert(actor.swing_velocity.length() > .1, "Landing nudges the house")
	var skeleton: Skeleton3D = actor.bird.find_child("Skeleton3D",true,false)
	assert(skeleton!=null and skeleton.get_bone_count()==12)
	var wing=skeleton.find_bone("Wing_Near")
	actor.animator.play("Fly");actor.animator.seek(0,true);var first=skeleton.get_bone_pose_rotation(wing)
	actor.animator.seek(.25,true);var second=skeleton.get_bone_pose_rotation(wing)
	assert(first.angle_to(second)>.4,"Wing animation must deform the skeleton")
	print("PARK_BIRD_SMOKE_OK states=",seen," bones=",skeleton.get_bone_count()," wing_delta=",first.angle_to(second))
	quit()
